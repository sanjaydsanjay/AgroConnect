# Supabase Credentials (Safe for frontend if NEXT_PUBLIC_ prefixed)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase Server-Side Credentials (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Application URL (Used for CORS in Edge Functions)
FRONTEND_URL=

# Backend Cron Secret (Used to secure scheduled endpoints like refresh-market-prices)
CRON_SECRET=

# External Market Price API Configuration (Server-side only)
MARKET_PRICE_API_URL=
MARKET_PRICE_API_KEY=

# AI Recommendation Service Configuration (Server-side only)
AI_API_URL=
AI_API_KEY=