# ==============================================================================
# AgriConnect Unified Backend & Microservices Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 FRONTEND APPLICATION CONFIGURATION (Public & Client-Side Safe)
# ------------------------------------------------------------------------------
# Public Supabase URL (used by @supabase/supabase-js in client browser)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon/Public Key (Safe for client-side bundle)
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Microservice Base URL (used by frontend aiClient.ts)
PUBLIC_AI_SERVICE_URL=http://localhost:8000

# Frontend Web Application Origin (used for CORS in Edge Functions & FastAPI)
FRONTEND_URL=http://localhost:4321


# ------------------------------------------------------------------------------
# 🤖 AI MICROSERVICE CONFIGURATION (FastAPI Engine & Open Datasets)
# ------------------------------------------------------------------------------
# AI Microservice Endpoint URL (used by Supabase Edge Functions)
AI_API_URL=http://localhost:8000
AI_API_KEY=your-ai-service-api-key

# Open Government Data (data.gov.in) Agmarknet Mandi API Key
DATA_GOV_API_KEY=your-data-gov-in-api-key

# Open-Meteo Weather Key (Free & Keyless by default)
WEATHER_API_KEY=

# Local Development & Fallback Toggles
USE_FALLBACK_DATA=false
USE_DEV_AUTH=true

# Server Host & Port Configuration
HOST=0.0.0.0
PORT=8000


# ------------------------------------------------------------------------------
# 🔐 BACKEND & SUPABASE SERVER-SIDE SECRETS (NEVER expose to Client/Frontend)
# ------------------------------------------------------------------------------
# Supabase JWT Secret (used by FastAPI auth.py to verify user JWTs locally)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Supabase Service Role Key (Admin secret - used inside Edge Functions only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cron Trigger Secret (secures scheduled edge functions like refresh-market-prices)
CRON_SECRET=your-cron-secret-key