# ==============================================================================
# AgriConnect Direct URL Environment Configuration Template (Keyless Open Access)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 FRONTEND APPLICATION CONFIGURATION (URL-Based Access)
# ------------------------------------------------------------------------------
# Supabase Project URL
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# AI Microservice Base URL (Directly accessible via HTTP)
PUBLIC_AI_SERVICE_URL=http://localhost:8000

# Frontend Web Application Origin (CORS Origin)
FRONTEND_URL=http://localhost:4321


# ------------------------------------------------------------------------------
# 🤖 AI MICROSERVICE CONFIGURATION (Direct FastAPI Engine)
# ------------------------------------------------------------------------------
# Direct AI Service URL
AI_API_URL=http://localhost:8000

# Local Server Host & Port Settings
HOST=0.0.0.0
PORT=8000

# Development & Fallback Toggles
USE_FALLBACK_DATA=false
USE_DEV_AUTH=true