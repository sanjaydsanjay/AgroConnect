# Open Government Data (OGD) Platform India API Key (data.gov.in)
# Register for free at https://data.gov.in to grab your key
DATA_GOV_API_KEY=your-data-gov-in-api-key

# Supabase Configuration (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Weather Source (Open-Meteo is free and keyless)
WEATHER_API_KEY=

# Fallback & Dev Toggles
USE_FALLBACK_DATA=false
USE_DEV_AUTH=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
