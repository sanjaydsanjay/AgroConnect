---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  href?: string;
  class?: string;
}

const { variant = 'primary', href, class: className = '' } = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 font-medium rounded-full transition-all duration-150 active:scale-[0.97] focus:outline-none focus:ring-2 focus:ring-[#0070f3] focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer select-none px-5 py-2.5 text-sm';

const variants: Record<string, string> = {
  primary:   'bg-[#171717] text-white hover:bg-black shadow-xs',
  secondary: 'bg-white text-[#171717] border border-[#ebebeb] hover:border-[#171717] hover:bg-[#fafafa] shadow-xs',
  outline:   'bg-transparent text-[#171717] border border-[#ebebeb] hover:border-[#171717] hover:bg-white/80',
};

const classes = `${base} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button class={classes} type="button">
    <slot />
  </button>
)}
