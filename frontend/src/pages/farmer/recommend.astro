---
import AppDashboardLayout from '../../layouts/AppDashboardLayout.astro';
import { SmartCropPlanner } from '../../components/react/farmer/SmartCropPlanner';
import { AuthGuard } from '../../components/react/auth/AuthGuard';
---

<AppDashboardLayout
  title="Smart Crop Planner | AgroConnect"
  activeRole="farmer"
  pageTitle="Smart Crop Planner & Weather Intelligence"
  pageSubtitle="Select your farm location, inspect live weather forecasts, and run AI crop suitability matching."
>
  <AuthGuard client:only="react" serviceTitle="AI Crop Suitability Engine" serviceDescription="Get tailored crop recommendations scored by real-time Mandi price trends and soil analytics.">
    <SmartCropPlanner client:load />
  </AuthGuard>
</AppDashboardLayout>
