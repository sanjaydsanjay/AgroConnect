---
import AppDashboardLayout from '../../layouts/AppDashboardLayout.astro';
import { FarmerDashboardOverview } from '../../components/react/farmer/FarmerDashboardOverview';
---

<AppDashboardLayout
  title="Farmer Dashboard | AgroConnect"
  activeRole="farmer"
  pageTitle="Dashboard"
  pageSubtitle="Farm overview, Smart Crop Planner recommendations, and buyer inquiries."
>
  <a
    slot="header-actions"
    href="/farmer/crop-planner"
    class="inline-flex items-center justify-center px-4 py-2 bg-[#171717] hover:bg-black text-white text-xs font-semibold rounded-md transition-colors shadow-xs"
  >
    Smart Crop Planner
  </a>
  <FarmerDashboardOverview client:load />
</AppDashboardLayout>
