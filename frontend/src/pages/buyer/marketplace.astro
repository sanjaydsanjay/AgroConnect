---
import AppDashboardLayout from '../../layouts/AppDashboardLayout.astro';
import { MarketplaceFilter } from '../../components/react/buyer/MarketplaceFilter';
import { MarketplaceGrid } from '../../components/react/buyer/MarketplaceGrid';
import { AuthGuard } from '../../components/react/auth/AuthGuard';
---

<AppDashboardLayout
  title="Produce Marketplace | AgroConnect"
  activeRole="buyer"
  pageTitle="Verified Produce Sourcing Marketplace"
  pageSubtitle="Search, filter, inspect produce specs, and submit order inquiries directly to verified farmers."
>
  <AuthGuard client:load serviceTitle="Produce Sourcing Marketplace" serviceDescription="Access verified farmer produce listings, voice search, live Mandi price comparison, and direct order placements.">
    <div class="space-y-6">
      <MarketplaceFilter client:load />
      <MarketplaceGrid client:load />
    </div>
  </AuthGuard>
</AppDashboardLayout>
