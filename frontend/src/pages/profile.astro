---
import AppDashboardLayout from '../layouts/AppDashboardLayout.astro';
import { UserProfile } from '../components/react/profile/UserProfile';
import { AuthGuard } from '../components/react/auth/AuthGuard';
---

<AppDashboardLayout
  title="My Profile | AgroConnect"
  pageTitle="User Profile"
  pageSubtitle="Manage your account profile information and preferences."
>
  <AuthGuard client:only="react" serviceTitle="User Account Profile" serviceDescription="View and manage your registered account details, contact preferences, and platform role settings.">
    <UserProfile client:load />
  </AuthGuard>
</AppDashboardLayout>
